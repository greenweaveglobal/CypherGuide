{
  "headers": [
    {
      "source": "/.well-known/nostr.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vi",
      "destination": "/vi/index.html"
    },
    {
      "source": "/vi/(.*)",
      "destination": "/vi/index.html"
    },
    {
      "source": "/((?!api/|\\.well-known/|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}

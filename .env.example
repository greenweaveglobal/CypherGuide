# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Upstash Redis for Vercel Serverless Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payment Mode: live | demo
VITE_PAYMENT_MODE=live

# Demo Mode Mutinynet Host Lightning Address (LUD-16) for real testnet sats payments
# Example: demo-host@voltage.cloud or your-lnbits-user@mutinynet.com
VITE_DEMO_HOST_LIGHTNING_ADDRESS=demo-host@voltage.cloud

# URL cho NIP-96 Media Server độc lập (Nếu dùng VPS riêng)
# VITE_MEDIA_SERVER_URL=https://media.cypherguide.org
# Danh sách NIP-96 Media Server dự phòng (phân cách bằng dấu phẩy)
# VITE_FALLBACK_MEDIA_SERVERS=https://nostr.build/api/v2/nip96,https://nostpic.com/api/v2/nip96

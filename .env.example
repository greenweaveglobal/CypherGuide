# Gemini API Key (Server-side documentation assistant)
GEMINI_API_KEY=

# Upstash Redis Distributed Storage & Rate Limiting (Used by server.ts and Vercel serverless)
# Database: cypherguide-ratelimit (ap-southeast-1). Enables distributed sliding-window rate limiters,
# NIP-98 anti-replay event ID cache, and persistent protocol configuration (cg:protocol_config).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical Public Base URL (optional, e.g. https://cypherguide.org for absolute NIP-98 URL verification)
PUBLIC_BASE_URL=

# Additional allowed CORS origins (comma-separated, e.g. for AI Studio preview or custom Cloud Run domain)
CORS_EXTRA_ORIGINS=

# URL cho NIP-96 Media Server độc lập (Nếu dùng VPS riêng)
# VITE_MEDIA_SERVER_URL=https://media.cypherguide.org
# Danh sách NIP-96 Media Server dự phòng (phân cách bằng dấu phẩy)
# VITE_FALLBACK_MEDIA_SERVERS=https://nostr.build/api/v2/nip96,https://nostpic.com/api/v2/nip96

